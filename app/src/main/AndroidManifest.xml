<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Unlocks SSID/BSSID on Wi-Fi and cell identity on cellular. Without FINE, Android
         redacts BSSID to 02:00:00:00:00:00 and returns an empty scan list. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Cellular registration and NR state. Without it, cell identity and signal still arrive
         via getAllCellInfo() under ACCESS_FINE_LOCATION, but NSA/SA cannot be distinguished —
         which is precisely the thing worth knowing at a venue. Requested but not gated on. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Required to call startScan(). Does not actually change any Wi-Fi state. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- API 33+. Deliberately WITHOUT usesPermissionFlags="neverForLocation": this app genuinely
         derives location from what it observes, so the honest declaration keeps the location tie. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Screen-off / background recording, via a foreground service.
         ACCESS_BACKGROUND_LOCATION is deliberately NOT requested: a foreground service declared
         with type="location" may access location while backgrounded without it. That permission is
         for apps wanting location with no visible service, and asking for it triggers a Play Store
         justification review and demo video for no benefit here. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wi-Fi is the Phase 1 measurement radio; telephony arrives in Phase 5. Neither is
         required=true, so the app stays installable on hardware lacking one. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RFTestApp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RFTestApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required to hand exported files to other apps. Sharing a raw file:// URI throws
             FileUriExposedException on modern Android; a content:// URI from FileProvider grants
             scoped, revocable read access to just the file being shared. -->

        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
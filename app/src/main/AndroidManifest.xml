<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Unlocks SSID/BSSID on Wi-Fi and cell identity on cellular. Without FINE, Android
         redacts BSSID to 02:00:00:00:00:00 and returns an empty scan list. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Cellular registration and NR state. Without it, cell identity and signal still arrive
         via getAllCellInfo() under ACCESS_FINE_LOCATION, but NSA/SA cannot be distinguished —
         which is precisely the thing worth knowing at a venue. Requested but not gated on. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
        Privileged (signature|privileged). Granted only where the app is installed in
        /system/priv-app AND allowlisted in a privapp-permissions XML; refused on an ordinary
        install, which is the normal case and is handled. It unlocks PhysicalChannelConfig,
        the modem's own view of which carriers it has configured.

        How much that is worth is a property of the handset, not of the permission. Measured on
        the OnePlus 9 (OOS 14, 2026-09-21) with the privileged install in place and a validated
        NR SA data connection under active load: connectionStatus, networkType and frequencyRange
        are populated; band, physicalCellId, channel number and bandwidth all come back as their
        UNKNOWN sentinels. The vendor RIL does not fill them in. So what this reliably buys on
        that handset is the carrier *count* and primary/secondary roles: still the only
        aggregation evidence available, since ServiceState reports mCellBandwidths=[] and
        isUsingCarrierAggregation=false regardless, plus the coarse LOW/MID/HIGH range.
        Anything reporting per-carrier RF detail must treat those fields as optional and absent.
    -->
    <!--
        Suppressed deliberately, not waved away: lint is correct that this is granted only
        to system apps, and that is the whole point. It is declared so a privileged install
        can be granted it, and the collector treats refusal as the normal path.
    -->
    <uses-permission android:name="android.permission.READ_PRECISE_PHONE_STATE"
        tools:ignore="ProtectedPermissions" />

    <!--
        Also privileged, and required to hold the radio on one access technology for the length
        of a measurement (see TechnologyLock). Selects a technology, never a band: Android exposes
        no band selection at any privilege level.

        Declaring this has a deployment consequence worth stating where it is declared. A handset
        with ro.control_privapp_permissions=enforce refuses to boot when a privileged app declares
        a privileged permission that no privapp-permissions XML allowlists. So this entry and the
        allowlist file change together, and the allowlist must be in place before the next reboot,
        not merely before the next install, which is the deadline it looks like.
    -->
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Required to call startScan(). Does not actually change any Wi-Fi state. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- API 33+. Deliberately WITHOUT usesPermissionFlags="neverForLocation": this app genuinely
         derives location from what it observes, so the honest declaration keeps the location tie. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Screen-off / background recording, via a foreground service.
         ACCESS_BACKGROUND_LOCATION is deliberately NOT requested: a foreground service declared
         with type="location" may access location while backgrounded without it. That permission is
         for apps wanting location with no visible service, and asking for it triggers a Play Store
         justification review and demo video for no benefit here. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wi-Fi is the Phase 1 measurement radio; telephony arrives in Phase 5. Neither is
         required=true, so the app stays installable on hardware lacking one. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RFTestApp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RFTestApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required to hand exported files to other apps. Sharing a raw file:// URI throws
             FileUriExposedException on modern Android; a content:// URI from FileProvider grants
             scoped, revocable read access to just the file being shared. -->

        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>